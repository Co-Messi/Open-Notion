/* ---------------- App shell ---------------- */
.app {
  display: flex;
  height: 100%;
  width: 100%;
  overflow: hidden;
  position: relative;
}

/* ---------------- Sidebar ---------------- */
.sidebar {
  position: relative;
  flex-shrink: 0;
  height: 100%;
  background: var(--sidebar-bg);
  box-shadow: inset -1px 0 0 0 var(--border-secondary-translucent);
  display: flex;
  flex-direction: column;
  color: var(--text-accent);
  font-size: 14px;
  user-select: none;
  z-index: 10;
  transition: width 0ms;
}
.sidebar.collapsed {
  position: absolute;
  left: 0;
  top: 0;
  height: auto;
  bottom: 0;
  transform: translateX(-100%);
  transition: transform 200ms ease, opacity 200ms ease;
  opacity: 0;
}
.sidebar.collapsed.peek {
  transform: translateX(0);
  opacity: 1;
  top: 52px;
  bottom: 52px;
  height: auto;
  border-radius: 0 10px 10px 0;
  box-shadow: var(--shadow-menu);
  background: var(--popover-bg);
}
.sidebar-scroll {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding-bottom: 12px;
  scrollbar-width: thin;
  scrollbar-color: transparent transparent;
}
.sidebar:hover .sidebar-scroll {
  scrollbar-color: var(--on-gray-background-tertiary-translucent) transparent;
}

.sb-search {
  margin: 6px 12px 0;
  height: 32px;
  border-radius: 8px;
  border: 1px solid var(--border-translucent);
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 6px 0 8px;
  color: var(--text-tertiary);
  cursor: pointer;
  font-size: 14px;
  background: var(--bg-primary);
  transition: background 20ms ease-in;
}
.theme-dark .sb-search {
  background: transparent;
}
.sb-search:hover {
  background: var(--hover);
}
.sb-search .label {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sb-search .kbd {
  font-size: 11px;
  font-weight: 500;
}

.sb-header-actions {
  position: absolute;
  top: 6px;
  right: 12px;
}

.sb-tabs {
  display: flex;
  gap: 8px;
  padding: 12px 12px 0;
}
.sb-tab {
  height: 32px;
  border-radius: 8px;
  padding: 0 10px 0 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 500;
  color: var(--text-secondary);
  cursor: pointer;
  white-space: nowrap;
}
.sb-tab svg {
  color: var(--icon-secondary);
}
.sb-tab:hover {
  background: var(--hover);
}
.sb-tab.active {
  background: var(--on-gray-background-secondary-translucent);
  color: var(--text-primary);
}
.sb-tab.active svg {
  color: var(--icon-primary);
}

.sb-group {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding: 0 8px;
}
.sb-group.top {
  margin-top: 12px;
}
.sb-section {
  margin-top: 16px;
}

.sb-row {
  height: 30px;
  min-height: 30px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  padding: 4px 8px;
  gap: 8px;
  color: var(--text-accent);
  font-size: 14px;
  line-height: 21px;
  cursor: pointer;
  position: relative;
  transition: background 20ms ease-in;
}
.sb-row:hover {
  background: var(--hover);
}
.sb-row.active {
  background: var(--sidebar-selected);
  color: var(--text-primary);
}
.sb-row.muted {
  color: var(--text-tertiary);
}
.sb-row.drop-into {
  box-shadow: inset 0 0 0 2px var(--on-palette-ui-blue-400);
  background: var(--select-blue);
}
.sb-row .sb-icon {
  width: 22px;
  height: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--icon-secondary);
  border-radius: 4px;
  position: relative;
}
.sb-row .sb-icon .emoji {
  font-size: 16px;
  line-height: 1;
}
.sb-row .sb-label {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.sb-row .sb-actions {
  display: none;
  align-items: center;
  gap: 2px;
  margin-right: -4px;
}
.sb-row:hover .sb-actions,
.sb-row.menu-open .sb-actions {
  display: flex;
}
.sb-row .sb-actions .icon-btn {
  width: 20px;
  height: 20px;
  border-radius: 4px;
  color: var(--icon-secondary);
}
.sb-row .sb-actions .icon-btn:hover {
  background: var(--on-gray-background-secondary-translucent);
}

/* Toggle caret takes over the icon on hover */
.sb-row .sb-caret {
  position: absolute;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  color: var(--icon-secondary);
  background: var(--sidebar-bg);
}
.sb-row:hover .sb-caret {
  display: flex;
}
.sb-row .sb-caret:hover {
  background: var(--on-gray-background-secondary-translucent);
}
.sb-caret svg {
  transition: transform 150ms ease;
}
.sb-caret.open svg {
  transform: rotate(90deg);
}

.sb-section-header {
  height: 30px;
  display: flex;
  align-items: center;
  padding: 0 8px;
  border-radius: 6px;
  margin: 0 8px;
  cursor: pointer;
  color: var(--text-tertiary);
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
  gap: 4px;
}
.sb-section-header:hover {
  background: var(--hover);
}
.sb-section-header .grow {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 4px;
}
.sb-section-header .chev {
  display: none;
  color: var(--icon-tertiary);
}
.sb-section-header:hover .chev {
  display: inline-flex;
}
.sb-section-header .sb-actions {
  display: none;
  gap: 2px;
}
.sb-section-header:hover .sb-actions {
  display: flex;
}
.sb-section-header .icon-btn {
  width: 20px;
  height: 20px;
  border-radius: 4px;
  color: var(--icon-secondary);
}
.sb-empty {
  padding: 4px 8px 4px 46px;
  color: var(--text-tertiary);
  font-size: 14px;
  line-height: 21px;
  height: 30px;
  display: flex;
  align-items: center;
}

.sb-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 12px 10px 8px;
  border-top: 1px solid transparent;
}
.sb-footer.scrolled {
  border-top-color: var(--border-secondary-translucent);
}
.sb-switcher {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 32px;
  padding: 0 8px;
  border-radius: 8px;
  cursor: pointer;
  min-width: 0;
  flex: 1;
  color: var(--text-primary);
  font-size: 14px;
  font-weight: 500;
}
.sb-switcher:hover {
  background: var(--hover);
}
.sb-switcher .ws-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.sb-switcher svg {
  color: var(--icon-secondary);
  flex-shrink: 0;
}
.sb-footer .icon-btn {
  width: 28px;
  height: 28px;
}
.ws-icon {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--on-gray-background-secondary-translucent);
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 600;
  flex-shrink: 0;
  line-height: 1;
}
.ws-icon.emoji {
  background: none;
  font-size: 18px;
}

.sb-resizer {
  position: absolute;
  top: 0;
  right: -4px;
  width: 8px;
  height: 100%;
  cursor: col-resize;
  z-index: 2;
}
.sb-resizer::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  left: 3px;
  width: 2px;
  background: transparent;
  transition: background 150ms;
}
.sb-resizer:hover::after,
.sb-resizer.dragging::after {
  background: var(--border-translucent);
}

.sb-drop-line {
  position: absolute;
  left: 8px;
  right: 8px;
  height: 2px;
  background: var(--on-palette-ui-blue-400);
  pointer-events: none;
  border-radius: 1px;
}

/* ---------------- Main frame ---------------- */
.main {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background: var(--bg-primary);
}

.topbar {
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 12px;
  gap: 4px;
  font-size: 14px;
  background: var(--bg-primary);
  position: relative;
  z-index: 5;
}
.topbar .crumbs {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
}
.crumb {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 28px;
  padding: 0 6px;
  border-radius: 6px;
  cursor: pointer;
  color: var(--text-primary);
  white-space: nowrap;
  min-width: 0;
  max-width: 240px;
}
.crumb:hover {
  background: var(--hover);
}
.crumb .t {
  overflow: hidden;
  text-overflow: ellipsis;
}
.crumb .emoji {
  font-size: 15px;
  line-height: 1;
}
.crumb-sep {
  color: var(--text-tertiary);
  margin: 0 1px;
  flex-shrink: 0;
}
.topbar .privacy {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 28px;
  padding: 0 6px;
  border-radius: 6px;
  color: var(--text-secondary);
  white-space: nowrap;
  cursor: pointer;
  margin-left: 8px;
}
.topbar .privacy:hover {
  background: var(--hover);
}
.topbar .privacy svg {
  color: var(--icon-tertiary);
}
.topbar .spacer {
  flex: 1;
}
.topbar .edited {
  color: var(--text-tertiary);
  white-space: nowrap;
  margin-right: 6px;
}
.topbar .tb-btn {
  height: 28px;
  padding: 0 8px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--text-primary);
  white-space: nowrap;
  cursor: pointer;
}
.topbar .tb-btn:hover {
  background: var(--hover);
}
.topbar .icon-btn {
  width: 28px;
  height: 28px;
  color: var(--icon-primary);
}
.topbar .icon-btn.fav-on {
  color: var(--favorite);
}

.frame {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  position: relative;
  scrollbar-width: thin;
}

/* ---------------- Home ---------------- */
.home {
  max-width: 900px;
  margin: 0 auto;
  padding: 36px 96px 120px;
}
.home h1 {
  font-size: 30px;
  font-weight: 700;
  line-height: 36px;
  text-align: center;
  margin: 24px 0 36px;
  color: var(--text-primary);
}
.home-section {
  margin-bottom: 36px;
}
.home-section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 500;
  color: var(--text-secondary);
  margin: 0 0 12px 8px;
}
.home-section-title svg {
  color: var(--icon-secondary);
}
.recent-row {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  padding: 2px 2px 12px;
  scrollbar-width: none;
}
.recent-card {
  flex: 0 0 144px;
  height: 144px;
  border-radius: 16px;
  background: var(--bg-primary);
  box-shadow: var(--shadow-card);
  position: relative;
  overflow: hidden;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  transition: background 120ms ease;
}
.theme-dark .recent-card {
  background: var(--on-gray-background-elevated);
  box-shadow: none;
}
.recent-card:hover {
  background: var(--on-card-hovered-background);
}
.recent-card .rc-top {
  height: 44px;
  background: var(--bg-secondary);
  flex-shrink: 0;
  background-size: cover;
  background-position: center;
}
.theme-dark .recent-card .rc-top {
  background-color: var(--on-gray-background-secondary);
}
.recent-card .rc-icon {
  position: absolute;
  left: 16px;
  top: 30px;
  font-size: 26px;
  line-height: 1;
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  color: var(--icon-secondary);
}
.recent-card .rc-body {
  padding: 34px 16px 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 1;
}
.recent-card .rc-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 18px;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.recent-card .rc-title.placeholder {
  color: var(--text-tertiary);
  font-weight: 500;
}
.recent-card .rc-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-tertiary);
}
.avatar {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  color: #fff;
  font-size: 9px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f6a04d, #e9585f);
}
.avatar.lg {
  width: 24px;
  height: 24px;
  font-size: 12px;
}

.learn-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.learn-card {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow-card);
  cursor: pointer;
  background: var(--bg-primary);
}
.theme-dark .learn-card {
  background: var(--on-gray-background-elevated);
  box-shadow: none;
}
.learn-card:hover {
  background: var(--on-card-hovered-background);
}
.learn-card .lc-art {
  height: 124px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44px;
  background: var(--bg-secondary);
}
.learn-card .lc-body {
  padding: 12px 14px 14px;
}
.learn-card .lc-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 18px;
  margin-bottom: 20px;
}
.learn-card .lc-meta {
  font-size: 12px;
  color: var(--text-tertiary);
  display: flex;
  align-items: center;
  gap: 6px;
}
.events-card {
  border-radius: 16px;
  box-shadow: var(--shadow-card);
  padding: 20px 24px;
  display: flex;
  gap: 32px;
  align-items: center;
  background: var(--bg-primary);
}
.theme-dark .events-card {
  background: var(--on-gray-background-elevated);
  box-shadow: none;
}
.events-card .ev-left {
  flex: 1;
  font-size: 14px;
  color: var(--text-secondary);
}
.events-card .ev-left b {
  display: block;
  color: var(--text-primary);
  font-weight: 500;
  margin: 8px 0 4px;
}
.events-card .ev-list {
  flex: 1.3;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.events-card .ev-item {
  display: flex;
  gap: 10px;
  font-size: 13px;
}
.events-card .ev-item .bar {
  width: 3px;
  border-radius: 2px;
  background: var(--on-blue-background-accent-primary);
}
.events-card .ev-item .when {
  color: var(--text-tertiary);
  font-size: 12px;
}
.btn-link {
  color: var(--blue);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
}

/* ---------------- Placeholder views (AI chat / meetings) ---------------- */
.empty-view {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--text-secondary);
  font-size: 14px;
  text-align: center;
  padding: 24px;
}
.empty-view h2 {
  margin: 0;
  font-size: 20px;
  color: var(--text-primary);
}

/* Library */
.library {
  max-width: 900px;
  margin: 0 auto;
  padding: 48px 96px 120px;
}
.library h1 {
  font-size: 32px;
  font-weight: 700;
  margin: 0 0 20px;
}
.lib-row {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 40px;
  padding: 0 8px;
  border-radius: 6px;
  cursor: pointer;
  border-bottom: 1px solid var(--border-secondary-translucent);
  font-size: 14px;
}
.lib-row:hover {
  background: var(--hover);
}
.lib-row .grow {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lib-row .muted {
  color: var(--text-tertiary);
  font-size: 12px;
}

/* Toast */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--on-background-accent-primary);
  color: var(--on-text-inverse-primary);
  font-size: 14px;
  padding: 8px 14px;
  border-radius: 8px;
  box-shadow: var(--shadow-menu);
  z-index: 1000;
  animation: toast-in 160ms ease;
}
.theme-dark .toast {
  background: var(--on-gray-background-secondary);
  color: var(--text-primary);
}
@keyframes toast-in {
  from {
    opacity: 0;
    transform: translate(-50%, 6px);
  }
}

/* ---------------- Side peek ---------------- */
.side-peek {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-primary);
  box-shadow: var(--on-shadow-outline-lg);
  z-index: 20;
  display: flex;
  flex-direction: column;
  animation: peek-in 180ms ease-out;
}
.theme-dark .side-peek {
  background: var(--on-gray-background-primary);
}
@keyframes peek-in {
  from {
    transform: translateX(40px);
    opacity: 0;
  }
}
.peek-resizer {
  position: absolute;
  left: -4px;
  top: 0;
  bottom: 0;
  width: 8px;
  cursor: col-resize;
  z-index: 2;
}
.peek-top {
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 0 10px;
}
.peek-top .icon-btn {
  width: 28px;
  height: 28px;
  color: var(--icon-secondary);
}
.peek-scroll {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: thin;
}
.peek-scroll .page-column {
  padding: 0 48px;
  max-width: none;
}
.peek-scroll .page-title {
  font-size: 32px;
}

/* ---------------- Tab strip (desktop-style) ---------------- */
.app-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  overflow: hidden;
}
.app-shell > .app {
  flex: 1;
  min-height: 0;
  height: auto;
}
.tabbar {
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
  background: var(--sidebar-bg);
  box-shadow: inset 0 -1px 0 var(--border-secondary-translucent);
  font-size: 14px;
  user-select: none;
  position: relative;
  z-index: 30;
}
.tabbar-left {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 8px;
  min-width: 0;
  box-shadow: inset -1px 0 0 var(--border-secondary-translucent);
}
.tb-ws {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 28px;
  padding: 0 6px;
  border-radius: 6px;
  min-width: 0;
  font-weight: 500;
  color: var(--text-primary);
  cursor: pointer;
}
.tb-ws:hover {
  background: var(--hover);
}
.tb-ws-name {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.tb-ws-chev {
  color: var(--icon-tertiary);
  flex-shrink: 0;
}
.tabbar-nav {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 0 6px;
  flex-shrink: 0;
}
.tabbar-nav .icon-btn {
  width: 28px;
  height: 28px;
  color: var(--icon-secondary);
}
.tabbar-nav .icon-btn.disabled {
  color: var(--icon-tertiary);
  opacity: 0.5;
  pointer-events: none;
}
.tabs {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: stretch;
  overflow: hidden;
}
.tab {
  flex: 0 1 220px;
  min-width: 64px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 6px 0 12px;
  color: var(--text-secondary);
  cursor: default;
  position: relative;
  transition: background 80ms ease;
}
.tab::before {
  content: '';
  position: absolute;
  left: 0;
  top: 9px;
  bottom: 9px;
  width: 1px;
  background: var(--border-secondary-translucent);
}
.tab:hover {
  background: var(--hover);
}
.tab.active {
  background: var(--bg-primary);
  color: var(--text-primary);
  box-shadow: inset 1px 0 0 var(--border-secondary-translucent), inset -1px 0 0 var(--border-secondary-translucent);
  z-index: 1;
}
.tab.active::before,
.tab.active + .tab::before {
  display: none;
}
.tab-icon {
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--icon-secondary);
}
.tab.active .tab-icon {
  color: var(--icon-primary);
}
.tab-label {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 18px), transparent);
  mask-image: linear-gradient(to right, #000 calc(100% - 18px), transparent);
}
.tab-close {
  width: 20px;
  height: 20px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--icon-secondary);
  opacity: 0;
  flex-shrink: 0;
}
.tab:hover .tab-close,
.tab.active .tab-close {
  opacity: 1;
}
.tab-close:hover {
  background: var(--on-gray-background-secondary-translucent);
}
.tab-new {
  width: 30px !important;
  height: 30px !important;
  align-self: center;
  margin-left: 4px;
  color: var(--icon-secondary);
}

/* Learn card mini illustrations */
.learn-card .lc-art {
  font-size: 14px;
  overflow: hidden;
  position: relative;
}
.art {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.art-keys {
  flex-direction: column;
  gap: 6px;
}
.art-keyrow {
  display: flex;
  gap: 5px;
}
.art-key {
  min-width: 26px;
  height: 24px;
  padding: 0 6px;
  border-radius: 6px;
  background: var(--bg-primary);
  box-shadow: 0 0 0 1px var(--border-translucent), 0 2px 0 var(--border-translucent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-secondary);
}
.art-slash {
  flex-direction: column;
  align-items: flex-start;
  padding: 14px 0 0 28px;
  justify-content: flex-start;
}
.art-line {
  font-size: 13px;
  color: var(--text-primary);
  margin-bottom: 4px;
}
.art-caret::after {
  content: '';
  display: inline-block;
  width: 1px;
  height: 13px;
  background: var(--text-primary);
  margin-left: 1px;
  vertical-align: -2px;
}
.art-menu {
  width: 150px;
  background: var(--popover-bg);
  border-radius: 8px;
  box-shadow: var(--shadow-menu);
  padding: 4px;
}
.art-menu-label {
  font-size: 9px;
  font-weight: 600;
  color: var(--text-tertiary);
  padding: 2px 6px 3px;
}
.art-menu-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10.5px;
  height: 17px;
  padding: 0 6px;
  border-radius: 4px;
  color: var(--text-primary);
}
.art-menu-item.on {
  background: var(--hover);
}
.art-ic {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  box-shadow: inset 0 0 0 1px var(--border-translucent);
  font-size: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  background: var(--bg-primary);
}
.art-board {
  gap: 8px;
  padding: 0 14px;
  align-items: flex-start;
  padding-top: 18px;
}
.art-col {
  flex: 1;
  border-radius: 8px;
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: var(--on-gray-background-primary-translucent);
}
.art-col.art-blue {
  background: var(--on-blue-background-primary);
}
.art-col.art-green {
  background: var(--on-green-background-primary);
}
.art-pill {
  align-self: flex-start;
  font-size: 9px;
  padding: 1px 6px;
  border-radius: 8px;
  background: var(--on-gray-background-secondary-translucent);
  color: var(--text-primary);
  white-space: nowrap;
}
.art-pill-blue {
  background: var(--on-blue-background-tertiary);
  color: var(--on-blue-text-primary);
}
.art-pill-green {
  background: var(--on-green-background-tertiary);
  color: var(--on-green-text-primary);
}
.art-card {
  background: var(--on-board-item-default-background);
  box-shadow: var(--on-shadow-outline-sm);
  border-radius: 5px;
  padding: 6px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.art-card span {
  height: 4px;
  border-radius: 2px;
  background: var(--on-gray-background-tertiary-translucent);
}
.art-card span + span {
  width: 60%;
}

/* Sidebar events and teamspaces */
.sb-event-dot {
  width: 10px;
  height: 10px;
  border-radius: 3px;
}
.sb-event-time {
  font-size: 12px;
  color: var(--text-tertiary);
  white-space: nowrap;
  flex-shrink: 0;
}
.sb-row.sb-event:hover .sb-event-time {
  color: var(--text-secondary);
}
.ws-icon.ts-icon {
  width: 20px;
  height: 20px;
  font-size: 13px;
  border-radius: 5px;
}
