/* OpenNotion theme tokens. Light values on :root, dark values on .theme-dark. */
:root,
.theme-light {
  color-scheme: light;
  --on-background-accent-primary: #2c2c2b;
  --on-background-elevated: #fff;
  --on-background-primary: #fff;
  --on-background-secondary: #f9f8f7;
  --on-background-tertiary: #f0efed;
  --on-blue-background-accent-primary: #2783de;
  --on-blue-background-primary: #f3f9fd;
  --on-blue-background-secondary: #e5f2fc;
  --on-blue-background-tertiary: #cee3f7;
  --on-blue-border-primary: #cee3f7;
  --on-blue-button-hovered-background: #0077d4;
  --on-blue-icon-secondary: #387dc9;
  --on-blue-text-primary: #264a72;
  --on-blue-text-secondary: #387dc9;
  --on-board-item-default-background: #fff;
  --on-border-primary: #e6e5e3;
  --on-border-primary-translucent: rgba(28,19,1,.11);
  --on-border-secondary-translucent: rgba(42,28,0,.07);
  --on-brown-background-secondary: #f5ede9;
  --on-brown-text-secondary: #9f765a;
  --on-button-hovered-background: rgba(55,53,47,.06);
  --on-ca-col-gal-pre-car-cov: rgba(55,53,47,.024);
  --on-calendar-item-background: #fff;
  --on-card-hovered-background: rgba(55,53,47,.04);
  --on-card-pressed-background: rgba(55,53,47,.06);
  --on-code-block-background: #f7f6f3;
  --on-embed-placeholder-background: #f2f1ee;
  --on-gray-background-elevated: #fff;
  --on-gray-background-primary: #f9f8f7;
  --on-gray-background-primary-translucent: rgba(66,35,3,.03);
  --on-gray-background-secondary: #f0efed;
  --on-gray-background-secondary-translucent: rgba(42,28,0,.07);
  --on-gray-background-tertiary-translucent: rgba(28,19,1,.11);
  --on-gray-icon-secondary: #7d7a75;
  --on-gray-text-primary: #494846;
  --on-gray-text-secondary: #7d7a75;
  --on-green-background-primary: #f6f9f7;
  --on-green-background-secondary: #e8f1ec;
  --on-green-background-tertiary: #d7e6dd;
  --on-green-text-primary: #2a533c;
  --on-green-text-secondary: #50946e;
  --on-icon-primary: #383836;
  --on-icon-secondary: #8e8b86;
  --on-icon-tertiary: #ada9a3;
  --on-input-blue-focus-ring: 0px 0px 0px 1px #2383e2 inset, 0px 0px 0px 1px #2383e2;
  --on-link-decoration-color: rgba(55,53,47,.25);
  --on-orange-background-secondary: #fbebde;
  --on-orange-text-secondary: #d27b2d;
  --on-overlay-smokescreen: rgba(15,15,15,.6);
  --on-page-title-placeholder-text-color: rgba(55,53,47,.15);
  --on-palette-ui-blue-100: rgba(35,131,226,.07);
  --on-palette-ui-blue-200: rgba(35,131,226,.14);
  --on-palette-ui-blue-300: rgba(35,131,226,.21);
  --on-palette-ui-blue-400: rgba(35,131,226,.35);
  --on-palette-ui-blue-600: #2383e2;
  --on-pink-background-secondary: #fae9f1;
  --on-pink-text-secondary: #c14c8a;
  --on-popover-background: #fff;
  --on-purple-background-secondary: #f3ebf9;
  --on-purple-icon-secondary: #9a6bb4;
  --on-purple-text-secondary: #9a6bb4;
  --on-red-background-accent-primary: #e56458;
  --on-red-background-primary: #fdf6f6;
  --on-red-background-secondary: #fce9e7;
  --on-red-border-strong: #f0c5be;
  --on-red-text-accent-primary: #e56458;
  --on-red-text-secondary: #cf5148;
  --on-shadow-mdprimary-outline: 0px 14px 28px -6px rgba(0,0,0,.1), 0px 2px 4px -1px rgba(0,0,0,.06), 0 0 0 1px rgba(28,19,1,.11);
  --on-shadow-outline-lg: 0px 20px 24px 0px rgba(25,25,25,.05), 0px 5px 8px 0px rgba(25,25,25,.027), 0px 0px 0px 1px rgba(42,28,0,.07);
  --on-shadow-outline-md: 0px 8px 12px 0px rgba(25,25,25,.027), 0px 2px 6px 0px rgba(25,25,25,.027), 0px 0px 0px 1px rgba(42,28,0,.07);
  --on-shadow-outline-scrim: 0px 24px 48px 0px rgba(25,25,25,.24), 0px 4px 12px 0px rgba(25,25,25,.14), 0px 0px 0px 1px rgba(42,28,0,.07);
  --on-shadow-outline-sm: 0px 2px 4px 0px rgba(0,0,0,.04), 0px 0px 0px 1px rgba(42,28,0,.07);
  --on-sidebar-item-selected-background: rgba(0,0,0,.03);
  --on-state-hover: rgba(55,53,47,.04);
  --on-state-pressed: rgba(55,53,47,.1);
  --on-switcher-toggle-desktop-track-bg: rgba(135,131,120,.4);
  --on-table-header-row-column-background: #f7f6f3;
  --on-table-row-hovered-background: rgba(55,53,47,.024);
  --on-text-accent-primary: #5f5e59;
  --on-text-disabled: #d4d3cf;
  --on-text-inverse-primary: #f0efed;
  --on-text-inverse-secondary: #ada9a3;
  --on-text-primary: #2c2c2b;
  --on-text-secondary: #7d7a75;
  --on-text-tertiary: #a19e99;
  --on-topbar-favorite: #f6c050;
  --on-yellow-background-accent-primary: #d8a32f;
  --on-yellow-background-secondary: #f9f3dc;
  --on-yellow-text-secondary: #cb9434;
  --on-gray-background-tertiary: #e6e5e3;
  --on-brown-background-tertiary: #ebdfd7;
  --on-brown-text-primary: #584437;
  --on-brown-icon-secondary: #9f765a;
  --on-brown-background-primary: #faf8f6;
  --on-orange-background-tertiary: #f3ddcb;
  --on-orange-text-primary: #6a4222;
  --on-orange-icon-secondary: #d27b2d;
  --on-orange-background-primary: #fcf7f4;
  --on-yellow-background-tertiary: #f2e3b7;
  --on-yellow-text-primary: #655121;
  --on-yellow-icon-secondary: #cb9434;
  --on-yellow-background-primary: #fcfaef;
  --on-green-icon-secondary: #50946e;
  --on-purple-background-tertiary: #e8dbf2;
  --on-purple-text-primary: #553b69;
  --on-purple-background-primary: #faf7fc;
  --on-pink-background-tertiary: #f4d8e4;
  --on-pink-text-primary: #68354e;
  --on-pink-icon-secondary: #c14c8a;
  --on-pink-background-primary: #fcf7f9;
  --on-red-background-tertiary: #f7d9d5;
  --on-red-text-primary: #6d3531;
  --on-red-icon-secondary: #cf5148;
}

.theme-dark {
  color-scheme: dark;
  --on-background-accent-primary: #2c2c2b;
  --on-background-elevated: #202020;
  --on-background-primary: #191919;
  --on-background-secondary: #202020;
  --on-background-tertiary: #383836;
  --on-blue-background-accent-primary: #2783de;
  --on-blue-background-primary: #1a2027;
  --on-blue-background-secondary: #233850;
  --on-blue-background-tertiary: #355f8b;
  --on-blue-border-primary: #233850;
  --on-blue-button-hovered-background: #0077d4;
  --on-blue-icon-secondary: #83abe1;
  --on-blue-text-primary: #e5f2fc;
  --on-blue-text-secondary: #387dc9;
  --on-board-item-default-background: rgba(255,255,255,.055);
  --on-border-primary: #383836;
  --on-border-primary-translucent: rgba(255,255,235,.1);
  --on-border-secondary-translucent: rgba(255,255,243,.082);
  --on-brown-background-secondary: #45362d;
  --on-brown-text-secondary: #9f765a;
  --on-button-hovered-background: rgba(255,255,255,.055);
  --on-ca-col-gal-pre-car-cov: rgba(255,255,255,.03);
  --on-calendar-item-background: #2f2f2f;
  --on-card-hovered-background: #2f2f2f;
  --on-card-pressed-background: #252525;
  --on-code-block-background: rgba(255,255,255,.03);
  --on-embed-placeholder-background: rgba(255,255,255,.03);
  --on-gray-background-elevated: #2c2c2b;
  --on-gray-background-primary: #202020;
  --on-gray-background-primary-translucent: rgba(252,252,252,.03);
  --on-gray-background-secondary: #383836;
  --on-gray-background-secondary-translucent: rgba(255,255,235,.1);
  --on-gray-background-tertiary-translucent: rgba(255,252,235,.306);
  --on-gray-icon-secondary: #7d7a75;
  --on-gray-text-primary: #f0efed;
  --on-gray-text-secondary: #7d7a75;
  --on-green-background-primary: #1b211d;
  --on-green-background-secondary: #263d30;
  --on-green-background-tertiary: #37674c;
  --on-green-text-primary: #e8f1ec;
  --on-green-text-secondary: #50946e;
  --on-icon-primary: #e6e5e3;
  --on-icon-secondary: #ada9a3;
  --on-icon-tertiary: #7d7a75;
  --on-input-blue-focus-ring: 0px 0px 0px 1px #2383e2 inset, 0px 0px 0px 1px #2383e2;
  --on-link-decoration-color: #373737;
  --on-orange-background-secondary: #53361f;
  --on-orange-text-secondary: #d27b2d;
  --on-overlay-smokescreen: rgba(15,15,15,.8);
  --on-page-title-placeholder-text-color: #373737;
  --on-palette-ui-blue-100: rgba(35,131,226,.07);
  --on-palette-ui-blue-200: rgba(35,131,226,.14);
  --on-palette-ui-blue-300: rgba(35,131,226,.2);
  --on-palette-ui-blue-400: rgba(35,131,226,.35);
  --on-palette-ui-blue-600: #2383e2;
  --on-pink-background-secondary: #4e2b3c;
  --on-pink-text-secondary: #c14c8a;
  --on-popover-background: #252525;
  --on-purple-background-secondary: #3c2d47;
  --on-purple-icon-secondary: #9a6bb4;
  --on-purple-text-secondary: #9a6bb4;
  --on-red-background-accent-primary: #e56458;
  --on-red-background-primary: #241d1d;
  --on-red-background-secondary: #502c29;
  --on-red-border-strong: #924943;
  --on-red-text-accent-primary: #e56458;
  --on-red-text-secondary: #cf5148;
  --on-shadow-mdprimary-outline: inset 0 0 0 1px rgba(255,255,235,.1), 0px 14px 28px -6px rgba(0,0,0,.2), 0px 2px 4px -1px rgba(0,0,0,.12);
  --on-shadow-outline-lg: 0px 0px 0px 1px #383836, 0px 14px 28px -6px rgba(25,25,25,.2), 0px 2px 4px -1px rgba(25,25,25,.118);
  --on-shadow-outline-md: 0px 0px 0px 1px #383836, 0px 4px 12px -2px rgba(25,25,25,.08);
  --on-shadow-outline-scrim: 0px 0px 0px 1px #383836, 0px 24px 48px 0px rgba(25,25,25,.64), 0px 4px 12px 0px rgba(25,25,25,.56);
  --on-shadow-outline-sm: 0px 0px 0px 1px #383836, 0px 2px 4px 0px rgba(25,25,25,.08);
  --on-sidebar-item-selected-background: rgba(255,255,255,.055);
  --on-state-hover: rgba(255,255,255,.055);
  --on-state-pressed: rgba(255,255,255,.13);
  --on-switcher-toggle-desktop-track-bg: rgba(120,129,135,.4);
  --on-table-header-row-column-background: rgba(255,255,255,.03);
  --on-table-row-hovered-background: rgba(255,255,255,.055);
  --on-text-accent-primary: #bcbab6;
  --on-text-disabled: #383836;
  --on-text-inverse-primary: #f0efed;
  --on-text-inverse-secondary: #ada9a3;
  --on-text-primary: #f0efed;
  --on-text-secondary: #ada9a3;
  --on-text-tertiary: #7d7a75;
  --on-topbar-favorite: #ca984d;
  --on-yellow-background-accent-primary: #d8a32f;
  --on-yellow-background-secondary: #504425;
  --on-yellow-text-secondary: #cb9434;
  --on-gray-background-tertiary: #5f5e59;
  --on-brown-background-tertiary: #6d5340;
  --on-brown-text-primary: #f5ede9;
  --on-brown-icon-secondary: #bca290;
  --on-brown-background-primary: #25201d;
  --on-orange-background-tertiary: #88522f;
  --on-orange-text-primary: #fbebde;
  --on-orange-icon-secondary: #cba27d;
  --on-orange-background-primary: #231e1b;
  --on-yellow-background-tertiary: #836426;
  --on-yellow-text-primary: #f9f3dc;
  --on-yellow-icon-secondary: #d8c283;
  --on-yellow-background-primary: #23221a;
  --on-green-icon-secondary: #8bb79d;
  --on-purple-background-tertiary: #674d7b;
  --on-purple-text-primary: #f3ebf9;
  --on-purple-background-primary: #221d25;
  --on-pink-background-tertiary: #7b4760;
  --on-pink-text-primary: #fae9f1;
  --on-pink-icon-secondary: #c897ad;
  --on-pink-background-primary: #261c20;
  --on-red-background-tertiary: #924943;
  --on-red-text-primary: #fce9e7;
  --on-red-icon-secondary: #d0988d;
}
